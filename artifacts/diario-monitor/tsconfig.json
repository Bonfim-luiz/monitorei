{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*", "app/**/*", "next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "build", "dist", ".next", "**/*.test.ts"],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@workspace/db": ["../../lib/db/src/index.ts"],
      "@workspace/db/*": ["../../lib/db/src/*"],
      "@workspace/redis": ["../../lib/redis/src/index.ts"],
      "@workspace/api-client-react": ["../../lib/api-client-react/src/index.ts"]
    }
  },
  "references": [
    { "path": "../../lib/api-client-react" },
    { "path": "../../lib/db" },
    { "path": "../../lib/redis" }
  ]
}
